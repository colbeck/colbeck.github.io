---
interface Entry {
  id: string;
  href?: string;
  label?: string;
  data: {
    title: string;
    date: Date;
    summary: string;
    tags?: string[];
  };
}

interface Props {
  entries: Entry[];
  basePath?: string;
  headingLevel?: "h2" | "h3";
}

const { entries, basePath = "/blog", headingLevel: Heading = "h2" } = Astro.props;
---

<div class="post-list">
  {
    entries.map((entry) => (
      <article class="post-card">
        <div class="post-card-meta">
          {entry.label && <span>{entry.label}</span>}
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString("en", {
              year: "numeric",
              month: "short",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>
        </div>
        <Heading>
          <a href={entry.href ?? `${basePath}/${entry.id}/`}>{entry.data.title}</a>
        </Heading>
        <p>{entry.data.summary}</p>
      </article>
    ))
  }
</div>
