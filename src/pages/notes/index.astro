---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Paper Notes | Cole Becker">
  <section class="page-shell narrow-shell">
    <h1 class="page-title">Paper notes</h1>
    <p class="lead">Main ideas from papers I’m reading. See <a href="/writing/">all writing</a>, including essays.</p>
  </section>

  <section class="page-shell section">
    <PostList entries={notes} basePath="/notes" />
  </section>
</BaseLayout>
