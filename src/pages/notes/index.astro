---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Paper Notes | Cole Becker">
  <section class="page-shell narrow-shell">
    <p class="eyebrow">Paper Notes</p>
    <p class="lead">Concise summaries and main ideas from papers I am reading.</p>
  </section>

  <section class="page-shell section">
    <PostList entries={notes} basePath="/notes" />
  </section>
</BaseLayout>
