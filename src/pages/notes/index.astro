---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Paper Notes | Cole Becker">
  <section class="page-shell narrow-shell">
    <p class="eyebrow">Paper Notes</p>
    <h1 class="page-title">Paper summaries, proof sketches, and reading notes.</h1>
    <p class="lead">A structured place for short summaries, main ideas, and questions to revisit.</p>
  </section>

  <section class="page-shell section">
    <PostList entries={notes} basePath="/notes" />
  </section>
</BaseLayout>
