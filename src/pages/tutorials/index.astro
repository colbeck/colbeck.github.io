---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const tutorials = (await getCollection("tutorials", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Tutorials | Cole Becker">
  <section class="page-shell narrow-shell">
    <h1 class="page-title">Tutorials</h1>
    <p class="lead">You can find my current essays and paper notes under <a href="/writing/">Writing</a>.</p>
  </section>

  {tutorials.length > 0 && (
    <section class="page-shell section">
      <PostList entries={tutorials} basePath="/tutorials" />
    </section>
  )}
</BaseLayout>
