---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import ProfileVisual from "../components/ProfileVisual.astro";
import PublicationList from "../components/PublicationList.astro";
import { publications, upcomingPublications } from "../data/publications";
import { getWriting } from "../lib/writing";

const recentWriting = (await getWriting()).slice(0, 2);

const homepageDescription =
  "Cole Becker is a PhD candidate at MIT LIDS working on faster sampling and adapting generative models through optimization and control.";

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://colebecker.me/#cole-becker",
  name: "Cole Becker",
  url: "https://colebecker.me/",
  image: "https://colebecker.me/assets/profile.jpg",
  jobTitle: "PhD candidate",
  affiliation: [
    {
      "@type": "CollegeOrUniversity",
      name: "Massachusetts Institute of Technology",
      alternateName: "MIT",
      sameAs: "https://www.mit.edu/",
    },
    {
      "@type": "Organization",
      name: "MIT Laboratory for Information and Decision Systems",
      alternateName: "MIT LIDS",
      sameAs: "https://lids.mit.edu/",
    },
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Princeton University",
    sameAs: "https://www.princeton.edu/",
  },
  sameAs: [
    "https://scholar.google.com/citations?user=ox1F6VIAAAAJ&hl=en",
    "https://www.linkedin.com/in/cole-becker-559102129/",
    "https://x.com/colemobecker",
  ],
  knowsAbout: [
    "Dynamical measure transport",
    "Sampling",
    "Generative modeling",
    "Optimization",
    "Control",
  ],
};
---

<BaseLayout title="Cole Becker | MIT" description={homepageDescription} structuredData={personStructuredData}>
  <section class="page-shell hero">
    <div>
      <p class="eyebrow">PhD candidate · MIT LIDS</p>
      <h1>Cole Becker</h1>
      <p class="lead">
        I’m a PhD candidate at MIT’s <a href="https://lids.mit.edu/">LIDS</a>,
        advised by <a href="https://www.mit.edu/~parrilo/">Pablo Parrilo</a> and supported by an NSF Graduate Research Fellowship.
      </p>
      <p class="lead">
        I work on making generative models faster and easier to adapt, using ideas from sampling,
        optimization, and control. I also collaborate with <a href="https://asu.mit.edu/">Asu Ozdaglar</a>{" "}
        and <a href="https://locomotion.csail.mit.edu/russt.html">Russ Tedrake</a>.
      </p>
      <p class="lead">
        Before MIT, I completed my undergraduate and master’s degrees at Princeton, working with <a href="https://stella.to/">Bartolomeo Stellato</a>{" "}
        and <a href="https://aaa.princeton.edu/">Amir Ali Ahmadi</a>.
      </p>
      <div class="social-links" aria-label="External profiles">
        <a href="mailto:colbeck@mit.edu">Email</a>
        <a href="https://scholar.google.com/citations?user=ox1F6VIAAAAJ&hl=en">Google Scholar</a>
        <a href="https://www.linkedin.com/in/cole-becker-559102129/">LinkedIn</a>
        <a href="https://x.com/colemobecker">Twitter</a>
        <a href="/assets/cv.pdf">CV</a>
      </div>
    </div>
    <ProfileVisual />
  </section>

  <section class="page-shell section" aria-labelledby="selected-papers">
    <div class="section-header">
      <h2 id="selected-papers">Selected publications</h2>
      <a href="/publications/">All publications →</a>
    </div>
    <PublicationList entries={[...upcomingPublications, ...publications.slice(0, 2)]} showSummary={false} />
  </section>

  <section class="page-shell section" aria-labelledby="recent-writing">
    <div class="section-header">
      <h2 id="recent-writing">Recent writing</h2>
      <a href="/writing/">All writing →</a>
    </div>
    <PostList entries={recentWriting} headingLevel="h3" />
  </section>
</BaseLayout>
