---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationList from "../components/PublicationList.astro";
---

<BaseLayout
  title="Research | Cole Becker"
  description="Research and publications by Cole Becker on diffusion sampling, generative modeling, optimization, and control."
>
  <section class="page-shell">
    <h1 class="page-title">Research</h1>
    <p class="lead">
      I study how probability distributions move, and how to use those dynamics to build better generative models.
      My work connects sampling and measure transport with optimization and control.
    </p>
    <p class="lead">
      My current projects focus on accelerating diffusion sampling through the joint design of noise schedules and
      solvers, adapting pretrained models to new objectives, and learning robot policies from simulated and real data.
    </p>
  </section>

  <section class="page-shell section" id="publications" aria-labelledby="publications-heading">
    <div class="section-header">
      <h2 id="publications-heading">Publications</h2>
      <a href="https://scholar.google.com/citations?user=ox1F6VIAAAAJ&hl=en">Google Scholar →</a>
    </div>
    <PublicationList />
  </section>
</BaseLayout>
