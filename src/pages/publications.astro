---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationList from "../components/PublicationList.astro";
import { publications, upcomingPublications } from "../data/publications";
---

<BaseLayout
  title="Publications | Cole Becker"
  description="Publications and preprints by Cole Becker, a PhD candidate at MIT."
>
  <section class="page-shell">
    <h1 class="page-title">Publications</h1>
    <p class="lead">Papers on diffusion policies, robust optimization, and learning uncertainty sets.</p>
    <div class="social-links" aria-label="Research links">
      <a href="https://scholar.google.com/citations?user=ox1F6VIAAAAJ&hl=en">Google Scholar</a>
    </div>
  </section>
  <section class="page-shell section" aria-label="Publication list">
    <PublicationList entries={[...upcomingPublications, ...publications]} headingLevel="h2" />
  </section>
</BaseLayout>
