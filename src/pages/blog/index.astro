---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Cole Becker">
  <section class="page-shell narrow-shell">
    <p class="eyebrow">Blog</p>
    <h1 class="page-title">Low quality thoughts on AI </h1>
    <p class="lead">A space I'm dedicating to writing on directions I am finding interesting, thinking about research taste, and asking broader questions. </p>
  </section>

  <section class="page-shell section">
    <PostList entries={posts} basePath="/blog" />
  </section>
</BaseLayout>
