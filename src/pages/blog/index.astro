---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Cole Becker">
  <section class="page-shell narrow-shell">
    <p class="eyebrow">Blog</p>
    <h1 class="page-title">Low quality thoughts on AI </h1>
    <p class="lead">A dedicated space for
    my general thoughts on AI, research directions that interest me, and ideas worth developing.
     </p>
  </section>

  <section class="page-shell section">
    <PostList entries={posts} basePath="/blog" />
  </section>
</BaseLayout>
