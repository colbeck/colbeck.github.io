---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Cole Becker">
  <section class="page-shell narrow-shell">
    <h1 class="page-title">Essays</h1>
    <p class="lead">Thoughts on research and ideas in progress. See <a href="/writing/">all writing</a>, including paper notes.</p>
  </section>

  <section class="page-shell section">
    <PostList entries={posts} basePath="/blog" />
  </section>
</BaseLayout>
